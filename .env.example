# ---------------------------------------------------------------------------
# Variables de entorno del Sistema Empresarial.
# Copia este archivo como ".env" (mismo directorio que manage.py) para
# desarrollo local. El archivo .env NO se sube a Git.
# ---------------------------------------------------------------------------

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Base de datos (Neon PostgreSQL) ---
# Cadena de conexión completa. Si se define, tiene prioridad sobre DB_*.
# Ejemplo: postgresql://usuario:clave@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Alternativa con variables individuales (sólo si DATABASE_URL está vacío).
DB_NAME=core_project_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Seguridad en producción ---
# Segundos de HSTS; 0 lo desactiva (recomendado durante las primeras pruebas).
DJANGO_HSTS_SECONDS=0
